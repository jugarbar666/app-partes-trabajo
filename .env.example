# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — GESTIÓN DE PARTES DE TRABAJO
# ==============================================================================
# IMPORTANTE:
# Cada empresa dispone de su propia instalación independiente (1 sitio Netlify +
# 1 proyecto Supabase independiente). Nunca compartas estas variables entre
# empresas distintas ni subas el archivo .env real a GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VARIABLES PÚBLICAS DE FRONTEND (Expuestas en el navegador vía Vite)
# ------------------------------------------------------------------------------
# URL del proyecto Supabase de la empresa
VITE_SUPABASE_URL="https://tu-proyecto-empresa.supabase.co"

# Clave pública anónima (anon key) de Supabase — sujeta siempre a políticas RLS
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Modo de ejecución local de demostración ("true" si aún no se han conectado credenciales reales)
VITE_ENABLE_LOCAL_ENGINE="true"

# Identificador único de la instalación (usado para deduplicación de backups e identificación)
VITE_INSTALLATION_SLUG="instalaciones-ejemplo-sl"

# ------------------------------------------------------------------------------
# 2. VARIABLES PRIVADAS EXCLUSIVAS DE SERVIDOR (PROHIBIDO usar prefijo VITE_)
# Configurar únicamente en Supabase Edge Functions / Vault / Netlify Functions / Runner de Backups
# ------------------------------------------------------------------------------
# Clave administrativa de servicio de Supabase (bypasses RLS — NUNCA en frontend)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9_SERVICE_ROLE_SECRET"

# Cadena de conexión directa PostgreSQL (solo para runner de backups pg_dump / restauración)
SUPABASE_DB_URL="postgresql://postgres:[PASSWORD]@db.tu-proyecto-empresa.supabase.co:5432/postgres"

# Proveedor de correo transaccional (Resend / Postmark / SMTP en Edge Function)
EMAIL_PROVIDER="resend"
EMAIL_API_KEY="re_secret_api_key_here"
EMAIL_FROM_ADDRESS="avisos@ominio-empresa.es"
EMAIL_FROM_NAME="Gestión de Partes y Revisiones"

# Secreto compartido entre pg_cron y las Edge Functions para autorizar tareas programadas
CRON_JOB_SECRET="generar-secreto-aleatorio-32-bytes-hex"

# Configuración del ejecutor y almacenamiento externo de Copias de Seguridad (S3/R2/Backblaze cifrado)
BACKUP_STORAGE_ENDPOINT="https://s3.eu-central-1.amazonaws.com"
BACKUP_STORAGE_BUCKET="backups-empresa-aislados"
BACKUP_STORAGE_ACCESS_KEY_ID="AKIA..."
BACKUP_STORAGE_SECRET_ACCESS_KEY="secret..."
BACKUP_ENCRYPTION_PASSPHRASE="passphrase-cifrado-aes256-copia-seguridad"
